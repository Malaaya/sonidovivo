# Copia este archivo como .env y cambia las claves. El .env real NO se sube a Git.

# --- Base de datos ---
DB_NAME=sonidovivo
DB_USER=ppuserdocker compose -f docker-compose.prod.yml down -v
DB_PASSWORD=
DB_ROOT_PASSWORD=secretroot

# --- Puertos publicados en tu máquina (docker-compose.yml) ---
BACKEND_PORT=8081
FRONTEND_PORT=80

# --- Solo para producción (docker-compose.prod.yml) ---
DOCKERHUB_USER=malaaya
IMAGE_TAG=1.0
JWT_SECRET=clave_secreta_jwt_larga_para_que_no_falle_el_backend